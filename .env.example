# COINVAULT Environment Variables
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=coinvault-dev-secret-key-change-in-production-super-secure-32chars
DATABASE_URL=sqlite:///coinvault.db
UPLOAD_FOLDER=app/static/uploads/avatars
MAX_CONTENT_LENGTH=5242880
RATELIMIT_DEFAULT="200 per day, 50 per hour"
SOCKETIO_ASYNC_MODE=threading
